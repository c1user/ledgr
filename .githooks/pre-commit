#!/bin/sh
# Pre-commit gate. Enable once per clone:  git config core.hooksPath .githooks
#
# Runs the backend regression tests, the shared-package tests (tokens drift,
# locale parity) and the lint of every workspace (frontend + packages).
# The ledger DB round-trip tests self-skip when Postgres isn't reachable,
# so this stays green in environments without a database.
set -e

repo_root="$(git rev-parse --show-toplevel)"

echo "→ backend tests"
(cd "$repo_root/backend" && npm test --silent)

echo "→ shared packages: tokens drift + locale parity"
(cd "$repo_root" && npm test --workspaces --if-present --silent)

echo "→ lint (frontend + packages)"
(cd "$repo_root" && npm run lint --workspaces --if-present --silent)

echo "✓ pre-commit checks passed"
