# AbacoPR Lite (mobile/) — build-time configuration. Copy to .env.local for a
# custom dev setup; the defaults below need NO .env file in development.
#
# VITE_API_URL — the API origin + /api path the phone talks to.
#   Development: leave it UNSET. vite.config.js proxies "/api" to the local
#   backend on http://localhost:5000, so the app uses the relative "/api" and
#   no CORS work is needed. (Testing in a phone browser over Wi-Fi: set it to
#   http://<your-PC-LAN-address>:5000/api and add that origin to the backend's
#   CORS_ORIGIN — ROADMAP-V6 2.14a.)
#   Production: REQUIRED and ABSOLUTE. Inside a Capacitor WebView the page
#   origin is capacitor://localhost or https://localhost, so a relative "/api"
#   cannot reach the server. `vite build` throws when this is missing.
VITE_API_URL=https://abacopr.com/api

# VITE_DEV_SHELL — set to 1 ONLY for the dev-shell bundle (the build that
# points at your PC, see README "Dev shell"): keeps the privacy screen off so
# emulator / device screenshots and recordings work. Never for a store build.
VITE_DEV_SHELL=

# VITE_BUILD — the native build number (integer) of this release; compared
# against GET /api/meta.minMobileBuild to show the "Update required" screen.
# 0 / unset = unversioned dev build (the gate is skipped).
VITE_BUILD=0
