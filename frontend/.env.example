# Frontend build-time configuration (Vite: variables must start with VITE_).
# Copy to .env or .env.production and adjust.

# API base URL. Unset:
#   dev  -> http://localhost:5000/api
#   prod -> /api (same-origin reverse proxy)
# Set explicitly when the API lives on another origin, e.g.:
# VITE_API_URL=https://api.example.com/api
