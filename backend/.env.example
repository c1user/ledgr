# ── Required (server refuses to start without these) ─────────
PORT=5000
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
DATABASE_URL=postgres://user:pass@localhost:5432/ledgr
ANTHROPIC_API_KEY=sk-ant-...
AWS_ACCESS_KEY_ID=...
AWS_SECRET_ACCESS_KEY=...
S3_BUCKET_NAME=...
AWS_REGION=us-east-1
CORS_ORIGIN=http://localhost:5173

# ── App URLs (used in emails: invite/join links, footers) ────
APP_URL=http://localhost:5173

# ── Outbound email (Roadmap v3 · Phase 1) ────────────────────
# Leave unset in dev: emails are composed and logged, not sent.
# For production, point at any SMTP provider (SES / Postmark /
# SendGrid / Gmail) and set up SPF + DKIM for the EMAIL_FROM
# domain at that provider so mail actually lands in inboxes.
# SMTP_HOST=email-smtp.us-east-1.amazonaws.com
# SMTP_PORT=587
# SMTP_USER=...
# SMTP_PASS=...
# SMTP_SECURE=false
# EMAIL_FROM="Abaco <no-reply@yourdomain.com>"

# Where in-app support requests are delivered (defaults to the brand
# no-reply address if unset — set this to a real inbox you read!)
# SUPPORT_EMAIL=support@yourdomain.com

# Field encryption at rest (employee SSNs) — generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYROLL_ENC_KEY=
