# ── Required (server refuses to start without these) ─────────
PORT=5000
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
DATABASE_URL=postgres://user:pass@localhost:5432/ledgr
ANTHROPIC_API_KEY=sk-ant-...
AWS_ACCESS_KEY_ID=...
AWS_SECRET_ACCESS_KEY=...
S3_BUCKET_NAME=...
AWS_REGION=us-east-1
# Comma-separated list. Dev: the Vite origin. Production: the website plus
# the native shells' webview origins (they are NOT the website origin):
#   Capacitor iOS  → capacitor://localhost   Capacitor Android → https://localhost
#   Tauri Windows  → http://tauri.localhost  Tauri macOS/Linux → tauri://localhost
# e.g. CORS_ORIGIN=https://abacopr.com,capacitor://localhost,https://localhost,http://tauri.localhost,tauri://localhost
CORS_ORIGIN=http://localhost:5173

# ── App URLs (used in emails: invite/join links, footers) ────
# Production: APP_URL=https://abacopr.com (CORS_ORIGIN: see the multi-origin list above)
APP_URL=http://localhost:5173

# ── Outbound email (Roadmap v3 · Phase 1) ────────────────────
# Leave unset in dev: emails are composed and logged, not sent.
# Production provider: Postmark (decision 2026-08-25). After verifying
# abacopr.com in Postmark (DKIM TXT + Return-Path CNAME in Cloudflare DNS,
# plus SPF include and a DMARC record), fill:
# SMTP_HOST=smtp.postmarkapp.com
# SMTP_PORT=587
# SMTP_USER=<Postmark Server API token>
# SMTP_PASS=<same Postmark Server API token>
# SMTP_SECURE=false
# EMAIL_FROM="Abaco <no-reply@abacopr.com>"

# Where in-app support requests are delivered (defaults to the brand
# no-reply address if unset — set this to a real inbox you read!)
# SUPPORT_EMAIL=soporte@abacopr.com

# Field encryption at rest (employee + vendor SSNs) — REQUIRED at boot.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Custody like JWT_SECRET, with an off-machine copy: losing this key loses
# every encrypted SSN permanently (PAYROLL_RUNBOOK.md).
PAYROLL_ENC_KEY=

# Reverse-proxy hops in front of the API (production: usually 1). Leave
# unset when clients hit Express directly (dev). Drives Express
# "trust proxy" so rate limiting keys on the real client IP.
# TRUST_PROXY=1

# ── Native shells (Capacitor / Tauri) ────────────────────────
# Lowest native build number this API still supports, served by the
# public GET /api/meta as minMobileBuild. Default 0 = every build is
# accepted. Raise it after a BREAKING API change (removed/renamed field,
# changed response shape) so phone builds older than that number show a
# "please update" screen instead of failing mid-flow. Web builds are
# unaffected — they always ship with the API.
# MIN_MOBILE_BUILD=0
